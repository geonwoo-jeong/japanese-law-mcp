{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/legal-query-baseline-v1.schema.json",
  "title": "Legal query evaluation baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "corpusVersion",
    "holdoutDigest",
    "profileSet",
    "baselineVersion",
    "sets"
  ],
  "properties": {
    "artifactKind": { "const": "legal_query_evaluation" },
    "schemaVersion": { "const": 1 },
    "corpusVersion": { "$ref": "#/$defs/corpusVersion" },
    "holdoutDigest": { "$ref": "#/$defs/sha256" },
    "profileSet": { "$ref": "#/$defs/profileSet" },
    "baselineVersion": { "$ref": "#/$defs/baselineVersion" },
    "sets": { "$ref": "#/$defs/sets" }
  },
  "$defs": {
    "asciiVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "baselineVersion": {
      "type": "string",
      "pattern": "^default-[1-9][0-9]*$",
      "maxLength": 64
    },
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "caseIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseId" },
      "maxItems": 46800,
      "uniqueItems": true
    },
    "corpusVersion": {
      "type": "string",
      "pattern": "^corpus-v[1-9][0-9]*$",
      "maxLength": 64
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion"],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "profileVersion": { "$ref": "#/$defs/asciiVersion" }
      }
    },
    "profileSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileSetId",
        "profileSetVersion",
        "rankingVersion",
        "profiles"
      ],
      "properties": {
        "profileSetId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "profileSetVersion": { "$ref": "#/$defs/asciiVersion" },
        "rankingVersion": { "$ref": "#/$defs/asciiVersion" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/profile" }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "numerator",
        "denominator",
        "ratio",
        "failedCaseIds"
      ],
      "properties": {
        "metricId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "numerator": { "type": "integer", "minimum": 0, "maximum": 400 },
        "denominator": { "type": "integer", "minimum": 0, "maximum": 400 },
        "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "failedCaseIds": { "$ref": "#/$defs/caseIds" }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "caseCount", "metrics"],
      "properties": {
        "categoryId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "caseCount": { "type": "integer", "minimum": 1, "maximum": 400 },
        "metrics": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "holdout", "execution"],
      "properties": {
        "development": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caseCount"],
          "properties": {
            "caseCount": { "type": "integer", "minimum": 1, "maximum": 400 }
          }
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseCount",
            "metrics",
            "categories",
            "derivedObservations",
            "failedCaseIds"
          ],
          "properties": {
            "caseCount": { "type": "integer", "minimum": 1, "maximum": 400 },
            "metrics": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": { "$ref": "#/$defs/metric" }
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "#/$defs/category" }
            },
            "derivedObservations": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/metric" }
            },
            "failedCaseIds": { "$ref": "#/$defs/caseIds" }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caseCount",
            "metrics",
            "wrongResourceCallCount",
            "budgetViolationCount",
            "attemptOrderViolationCount",
            "implicitFirstReadCount",
            "emptyReclassificationCount",
            "failedCaseIds"
          ],
          "properties": {
            "caseCount": { "type": "integer", "minimum": 1, "maximum": 400 },
            "metrics": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/metric" }
            },
            "wrongResourceCallCount": { "type": "integer", "minimum": 0 },
            "budgetViolationCount": { "type": "integer", "minimum": 0 },
            "attemptOrderViolationCount": { "type": "integer", "minimum": 0 },
            "implicitFirstReadCount": { "type": "integer", "minimum": 0 },
            "emptyReclassificationCount": { "type": "integer", "minimum": 0 },
            "failedCaseIds": { "$ref": "#/$defs/caseIds" }
          }
        }
      }
    }
  }
}
