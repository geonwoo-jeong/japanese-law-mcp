{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/legal-query-adoption-v1.schema.json",
  "title": "Legal query profile set adoption v1",
  "oneOf": [
    { "$ref": "#/$defs/pointer" },
    { "$ref": "#/$defs/adoption" }
  ],
  "$defs": {
    "adoptionId": {
      "type": "string",
      "pattern": "^adoption-sha256-[0-9a-f]{64}$"
    },
    "asciiVersion": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "schemaVersion", "adoptionId"],
      "properties": {
        "artifactKind": { "const": "legal_query_adoption_pointer" },
        "schemaVersion": { "const": 1 },
        "adoptionId": { "$ref": "#/$defs/adoptionId" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion", "cueSetVersion"],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "profileVersion": { "$ref": "#/$defs/asciiVersion" },
        "cueSetVersion": { "$ref": "#/$defs/asciiVersion" }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "schemaVersion",
        "adoptionId",
        "profileSetId",
        "profileSetVersion",
        "rankingVersion",
        "compositionVersion",
        "evaluatorVersion",
        "profiles",
        "corpusVersion",
        "holdoutDigest",
        "baselineVersion",
        "baselineSha256",
        "catalogVersion",
        "catalogSha256"
      ],
      "properties": {
        "artifactKind": { "const": "legal_query_adoption" },
        "schemaVersion": { "const": 1 },
        "adoptionId": { "$ref": "#/$defs/adoptionId" },
        "previousAdoptionId": { "$ref": "#/$defs/adoptionId" },
        "profileSetId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "profileSetVersion": { "$ref": "#/$defs/asciiVersion" },
        "rankingVersion": { "$ref": "#/$defs/asciiVersion" },
        "compositionVersion": { "$ref": "#/$defs/asciiVersion" },
        "evaluatorVersion": {
          "type": "string",
          "pattern": "^legal-query-evaluator-v[1-9][0-9]*$",
          "maxLength": 64
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/profile" }
        },
        "corpusVersion": {
          "type": "string",
          "pattern": "^corpus-v[1-9][0-9]*$",
          "maxLength": 64
        },
        "holdoutDigest": { "$ref": "#/$defs/digest" },
        "baselineVersion": {
          "type": "string",
          "pattern": "^default-[1-9][0-9]*$",
          "maxLength": 64
        },
        "baselineSha256": { "$ref": "#/$defs/digest" },
        "catalogVersion": {
          "type": "string",
          "pattern": "^unified-query-examples-v[1-9][0-9]*$",
          "maxLength": 64
        },
        "catalogSha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
